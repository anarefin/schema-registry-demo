<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>schema-registry-demo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- Code-first customer contracts (spec code-first D2/D4; topology ownership per spec
       contract-owned-amqp-topology; generation ownership per ADR-0003). The annotated event
       records are the source of truth; this module generates its own JSON Schemas at its own
       process-classes phase (via the schema-gen-tools exec-maven-plugin execution below) and
       commits them under resources/schemas/. No victools on the compile classpath — only Jackson
       (records) + Jakarta Validation (annotations read at generation time) +
       spring-rabbit/spring-boot-autoconfigure + event-contract-kit, since this module provides
       an opt-in domain-scoped AMQP topology (CustomerPublisherTopology, @Import-ed by the
       publisher) and auto-activated TypeMapping wiring (CustomerTypeMappingAutoConfiguration). -->
  <artifactId>customer-contracts</artifactId>
  <packaging>jar</packaging>

  <properties>
    <!-- The one incompatible-change resource for this domain, consumed by the parent's
         incompatible-demo profile (spec code-first D4). apicurio.registry.url is inherited. -->
    <apicurio.incompatible.group>events.customers</apicurio.incompatible.group>
    <apicurio.incompatible.artifact>CustomerRegistered</apicurio.incompatible.artifact>
    <apicurio.incompatible.file>${project.basedir}/src/test/resources/schemas/customer-registered-incompatible.schema.json</apicurio.incompatible.file>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Jakarta Validation annotations on the records (read by victools at schema-generation time). -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>

    <!-- This domain owns its own AMQP topology (spec contract-owned-amqp-topology D2). -->
    <dependency>
      <groupId>org.springframework.amqp</groupId>
      <artifactId>spring-rabbit</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>event-contract-kit</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test-only: lets the value-object round-trip tests (de)serialize the records' Instant
         fields as ISO-8601. Kept at test scope so the compile classpath stays pure. -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test-only: backs CustomerContractsSchemaDeterminismTest, which calls
         SchemaGenerator.generate directly to assert the committed schemas match a fresh
         generation (ADR-0003). This is the reverse of the old schema-gen-tools ->
         customer-contracts direction and creates no cycle. -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>schema-gen-tools</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Contracts and core must not depend on each other (spec contract-owned-amqp-topology
           Principle 2, restored by ADR-0006 now that TypeMapping/SchemaCoordinates/SchemaType
           live in event-contract-kit instead of core). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-core-module</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.example:schema-messaging-core</exclude>
                  </excludes>
                  <message>customer-contracts must not depend on schema-messaging-core (contracts and core must not depend on each other).</message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Generate this domain's JSON Schemas from @GenerateSchema-annotated records at its own
           process-classes phase (ADR-0003). schema-gen-tools is a plugin-level dependency only
           (not a project dependency), so it stays dependency-free with respect to this module
           while still building first in the reactor. Discovers types via package scan of
           ${project.build.outputDirectory} — no hand-listed FQCNs.
           Run standalone via: ./mvnw -pl customer-contracts process-classes -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>com.example</groupId>
            <artifactId>schema-gen-tools</artifactId>
            <version>${project.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>generate-schemas</id>
            <phase>process-classes</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>com.example.schemagen.SchemaGeneratorCli</mainClass>
              <includePluginDependencies>true</includePluginDependencies>
              <arguments>
                <argument>${project.basedir}/src/main/resources/schemas</argument>
                <argument>${project.build.outputDirectory}</argument>
                <argument>com.example.contracts.customers</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Seed the three customer artifacts from their generated schemas (spec code-first D4).
           The FORWARD compatibility rule + v1 reset are attached via the data-driven bootstrap.
           Run: ./mvnw -pl customer-contracts apicurio-registry:register
           Override URL: -Dapicurio.registry.url=http://host:8080 -->
      <plugin>
        <groupId>io.apicurio</groupId>
        <artifactId>apicurio-registry-maven-plugin</artifactId>
        <!-- version + registryUrl inherited from the parent pluginManagement (spec code-first D4).
             This POM supplies only the per-artifact coordinates; the parent's compat-check profile
             reuses this same <artifacts> list for the dry-run merge gate. -->
        <configuration>
          <artifacts>
            <artifact>
              <groupId>events.customers</groupId>
              <artifactId>CustomerRegistered</artifactId>
              <file>${project.basedir}/src/main/resources/schemas/customer-registered.schema.json</file>
              <artifactType>JSON</artifactType>
              <ifExists>FIND_OR_CREATE_VERSION</ifExists>
            </artifact>
            <artifact>
              <groupId>events.customers</groupId>
              <artifactId>CustomerAddressAdded</artifactId>
              <file>${project.basedir}/src/main/resources/schemas/customer-address-added.schema.json</file>
              <artifactType>JSON</artifactType>
              <ifExists>FIND_OR_CREATE_VERSION</ifExists>
            </artifact>
            <artifact>
              <groupId>events.customers</groupId>
              <artifactId>CustomerTierChanged</artifactId>
              <file>${project.basedir}/src/main/resources/schemas/customer-tier-changed.schema.json</file>
              <artifactType>JSON</artifactType>
              <ifExists>FIND_OR_CREATE_VERSION</ifExists>
            </artifact>
          </artifacts>
        </configuration>
      </plugin>

    </plugins>
  </build>
</project>
