<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>schema-registry-demo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- Code-first order contracts (spec code-first D2/D4). PURE contract jar: the annotated event
       records are the source of truth, their JSON Schemas are generated (by schema-gen-tools) and
       committed under resources/schemas/. No victools and no Spring/AMQP on the classpath — only
       Jackson (records) + Jakarta Validation (annotations read at generation time). -->
  <artifactId>order-contracts</artifactId>
  <packaging>jar</packaging>

  <properties>
    <!-- The one incompatible-change resource for this domain, consumed by the parent's
         incompatible-demo profile (spec code-first D4). apicurio.registry.url is inherited. -->
    <apicurio.incompatible.group>events.orders</apicurio.incompatible.group>
    <apicurio.incompatible.artifact>OrderCreated</apicurio.incompatible.artifact>
    <apicurio.incompatible.file>${project.basedir}/src/test/resources/schemas/order-created-incompatible.schema.json</apicurio.incompatible.file>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Jakarta Validation annotations on the records (read by victools at schema-generation time). -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test-only: lets the value-object round-trip tests (de)serialize the records' Instant
         fields as ISO-8601. Kept at test scope so the compile classpath stays pure. -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Seed the three order artifacts from their generated schemas (spec code-first D4).
           The FORWARD compatibility rule + v1 reset are attached via the data-driven bootstrap.
           Run: ./mvnw -pl order-contracts apicurio-registry:register
           Override URL: -Dapicurio.registry.url=http://host:8080 -->
      <plugin>
        <groupId>io.apicurio</groupId>
        <artifactId>apicurio-registry-maven-plugin</artifactId>
        <!-- version + registryUrl inherited from the parent pluginManagement (spec code-first D4).
             This POM supplies only the per-artifact coordinates; the parent's compat-check profile
             reuses this same <artifacts> list for the dry-run merge gate. -->
        <configuration>
          <artifacts>
            <artifact>
              <groupId>events.orders</groupId>
              <artifactId>OrderCreated</artifactId>
              <file>${project.basedir}/src/main/resources/schemas/order-created.schema.json</file>
              <artifactType>JSON</artifactType>
              <ifExists>FIND_OR_CREATE_VERSION</ifExists>
            </artifact>
            <artifact>
              <groupId>events.orders</groupId>
              <artifactId>OrderShipped</artifactId>
              <file>${project.basedir}/src/main/resources/schemas/order-shipped.schema.json</file>
              <artifactType>JSON</artifactType>
              <ifExists>FIND_OR_CREATE_VERSION</ifExists>
            </artifact>
            <artifact>
              <groupId>events.orders</groupId>
              <artifactId>OrderCancelled</artifactId>
              <file>${project.basedir}/src/main/resources/schemas/order-cancelled.schema.json</file>
              <artifactType>JSON</artifactType>
              <ifExists>FIND_OR_CREATE_VERSION</ifExists>
            </artifact>
          </artifacts>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
