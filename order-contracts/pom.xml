<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>schema-registry-demo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- T-3.7: JSON Schema contracts jar. Carries OrderCreated schema (Jackson) plus its
       own AMQP routing/topology auto-configuration (spring-amqp + spring-boot-autoconfigure),
       self-contained with no dependency on schema-messaging-core. -->
  <artifactId>order-contracts</artifactId>
  <packaging>jar</packaging>

  <properties>
    <!-- Override on CLI: ./mvnw apicurio-registry:register -Dapicurio.registry.url=http://host:8080 -->
    <apicurio.registry.url>http://localhost:8080</apicurio.registry.url>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- AMQP routing/topology for OrderCreated (self-contained, no dependency on schema-messaging-core) -->
    <dependency>
      <groupId>org.springframework.amqp</groupId>
      <artifactId>spring-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- T-3.2: Generate OrderCreated POJO from order-created.json (Draft 2020-12).
           Wire format: raw JSON bytes, no envelope (spec §6). -->
      <plugin>
        <groupId>org.jsonschema2pojo</groupId>
        <artifactId>jsonschema2pojo-maven-plugin</artifactId>
        <version>${jsonschema2pojo-maven-plugin.version}</version>
        <configuration>
          <sourceDirectory>${project.basedir}/src/main/resources/schemas</sourceDirectory>
          <targetPackage>com.example.contracts.orders</targetPackage>
          <annotationStyle>jackson2</annotationStyle>
          <sourceType>jsonschema</sourceType>
          <generateBuilders>true</generateBuilders>
          <includeHashcodeAndEquals>true</includeHashcodeAndEquals>
          <includeToString>true</includeToString>
          <useTitleAsClassname>true</useTitleAsClassname>
          <dateTimeType>java.lang.String</dateTimeType>
          <initializeCollections>false</initializeCollections>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- T-3.4 / T-4.1: Register OrderCreated. The COMPATIBILITY rule for this
           JSON Schema artifact is FORWARD (not BACKWARD): Apicurio's JSON Schema checker
           classifies adding any property as OBJECT_TYPE_PROPERTY_SCHEMAS_NARROWED, which
           BACKWARD rejects but FORWARD accepts. The rule is attached via REST/bootstrap.
           Run: ./mvnw -pl order-contracts apicurio-registry:register
           Override URL: -Dapicurio.registry.url=http://host:8080
           v2 (promoCode, notes, input1, userName) are FORWARD-compatible additions. -->
      <plugin>
        <groupId>io.apicurio</groupId>
        <artifactId>apicurio-registry-maven-plugin</artifactId>
        <version>${apicurio-registry-maven-plugin.version}</version>
        <configuration>
          <registryUrl>${apicurio.registry.url}</registryUrl>
          <artifacts>
            <!-- v1: required fields only — registered first to establish the baseline version. -->
            <artifact>
              <groupId>events.orders</groupId>
              <artifactId>OrderCreated</artifactId>
              <file>${project.basedir}/src/test/resources/schemas/order-created-v1.json</file>
              <artifactType>JSON</artifactType>
              <ifExists>FIND_OR_CREATE_VERSION</ifExists>
            </artifact>
            <!-- latest: src/main schema adds optional promoCode/notes/input1/userName,
                 each a FORWARD-compatible property addition. -->
            <artifact>
              <groupId>events.orders</groupId>
              <artifactId>OrderCreated</artifactId>
              <file>${project.basedir}/src/main/resources/schemas/order-created.json</file>
              <artifactType>JSON</artifactType>
              <ifExists>FIND_OR_CREATE_VERSION</ifExists>
            </artifact>
          </artifacts>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Step 1 of the rule-first flow: register ONLY the v1 baseline so the OrderCreated
         artifact exists. An artifact-level compatibility rule can only be attached to an
         existing artifact, so the baseline must be created before the rule is attached.
         Run: ./mvnw -pl order-contracts verify -Pbaseline -Dapicurio.registry.url=http://localhost:8080 -->
    <profile>
      <id>baseline</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.apicurio</groupId>
            <artifactId>apicurio-registry-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>register-baseline</id>
                <phase>verify</phase>
                <goals><goal>register</goal></goals>
                <configuration>
                  <registryUrl>${apicurio.registry.url}</registryUrl>
                  <artifacts>
                    <artifact>
                      <groupId>events.orders</groupId>
                      <artifactId>OrderCreated</artifactId>
                      <file>${project.basedir}/src/test/resources/schemas/order-created-v1.json</file>
                      <artifactType>JSON</artifactType>
                      <ifExists>FIND_OR_CREATE_VERSION</ifExists>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Optional dry-run pre-flight: checks the current schema is compatible (FORWARD for this
         JSON artifact) with what is registered, WITHOUT writing a new version. Requires a
         running registry. Governance itself is enforced by the real (non-dry-run) register
         goal above — this profile is just a convenience check.
         Run: ./mvnw -pl order-contracts verify -Pcompat-check -->
    <profile>
      <id>compat-check</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.apicurio</groupId>
            <artifactId>apicurio-registry-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>compat-gate</id>
                <phase>verify</phase>
                <goals><goal>register</goal></goals>
                <configuration>
                  <registryUrl>${apicurio.registry.url}</registryUrl>
                  <dryRun>true</dryRun>
                  <artifacts>
                    <artifact>
                      <groupId>events.orders</groupId>
                      <artifactId>OrderCreated</artifactId>
                      <file>${project.basedir}/src/main/resources/schemas/order-created.json</file>
                      <artifactType>JSON</artifactType>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- T-4.3 / T-4.6 incompatible demo: runs the dry-run register with a schema that
         changes quantity from integer to string — a type change of an existing property,
         incompatible under every compatibility level (FORWARD, BACKWARD, FULL).
         This MUST fail with a clear compatibility rejection message.
         Demo: ./mvnw -pl order-contracts verify -Pincompatible-demo -Dapicurio.registry.url=http://localhost:8080
         (requires a prior version already registered with the FORWARD rule) -->
    <profile>
      <id>incompatible-demo</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.apicurio</groupId>
            <artifactId>apicurio-registry-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>incompatible-compat-check</id>
                <phase>verify</phase>
                <goals><goal>register</goal></goals>
                <configuration>
                  <registryUrl>${apicurio.registry.url}</registryUrl>
                  <dryRun>true</dryRun>
                  <artifacts>
                    <artifact>
                      <groupId>events.orders</groupId>
                      <artifactId>OrderCreated</artifactId>
                      <file>${project.basedir}/src/test/resources/schemas/order-created-incompatible.json</file>
                      <artifactType>JSON</artifactType>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
