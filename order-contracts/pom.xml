<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>schema-registry-demo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- T-3.7: Protobuf contracts jar. Carries OrderCreated schema (protobuf-java) plus its
       own AMQP routing/topology auto-configuration (spring-amqp + spring-boot-autoconfigure),
       self-contained with no dependency on schema-messaging-core. -->
  <artifactId>order-contracts</artifactId>
  <packaging>jar</packaging>

  <properties>
    <!-- Override on CLI: ./mvnw apicurio-registry:register -Dapicurio.registry.url=http://host:8080 -->
    <apicurio.registry.url>http://localhost:8080</apicurio.registry.url>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>

    <!-- AMQP routing/topology for OrderCreated (self-contained, no dependency on schema-messaging-core) -->
    <dependency>
      <groupId>org.springframework.amqp</groupId>
      <artifactId>spring-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- os-maven-plugin provides ${os.detected.classifier} needed by protoc artifact resolution. -->
    <extensions>
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>${os-maven-plugin.version}</version>
      </extension>
    </extensions>

    <plugins>
      <!-- T-3.2: Generate OrderCreated class from order-created.proto.
           Wire format: pure protobuf bytes, no magic byte, no length prefix (spec §6). -->
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>${protobuf-maven-plugin.version}</version>
        <configuration>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <protoSourceRoot>${project.basedir}/src/main/resources/schemas</protoSourceRoot>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- T-3.4 / T-4.1: Register OrderCreated and attach BACKWARD rule.
           Run: ./mvnw -pl order-contracts apicurio-registry:register
           Override URL: -Dapicurio.registry.url=http://host:8080
           v2 (promo_code field 8) is a BACKWARD-compatible addition: old consumers ignore it. -->
      <plugin>
        <groupId>io.apicurio</groupId>
        <artifactId>apicurio-registry-maven-plugin</artifactId>
        <version>${apicurio-registry-maven-plugin.version}</version>
        <configuration>
          <registryUrl>${apicurio.registry.url}</registryUrl>
          <artifacts>
            <!-- v1: fields 1-7 only — registered first to establish the baseline version. -->
            <artifact>
              <groupId>events.orders</groupId>
              <artifactId>OrderCreated</artifactId>
              <file>${project.basedir}/src/test/resources/schemas/order-created-v1.proto</file>
              <artifactType>PROTOBUF</artifactType>
              <ifExists>FIND_OR_CREATE_VERSION</ifExists>
            </artifact>
            <!-- v2: adds optional promo_code (field 8) — BACKWARD-compatible addition. -->
            <artifact>
              <groupId>events.orders</groupId>
              <artifactId>OrderCreated</artifactId>
              <file>${project.basedir}/src/main/resources/schemas/order-created.proto</file>
              <artifactType>PROTOBUF</artifactType>
              <ifExists>FIND_OR_CREATE_VERSION</ifExists>
            </artifact>
          </artifacts>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- T-4.5 CI merge gate: checks the current schema is BACKWARD-compatible with what is
         registered. Requires a running registry. Run during CI after docker compose up:
         ./mvnw -pl order-contracts verify -Pcompat-check
         Or explicitly: ./mvnw -pl order-contracts apicurio-registry:test -Pcompat-check -->
    <profile>
      <id>compat-check</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.apicurio</groupId>
            <artifactId>apicurio-registry-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>compat-gate</id>
                <phase>verify</phase>
                <goals><goal>register</goal></goals>
                <configuration>
                  <registryUrl>${apicurio.registry.url}</registryUrl>
                  <dryRun>true</dryRun>
                  <artifacts>
                    <artifact>
                      <groupId>events.orders</groupId>
                      <artifactId>OrderCreated</artifactId>
                      <file>${project.basedir}/src/main/resources/schemas/order-created.proto</file>
                      <artifactType>PROTOBUF</artifactType>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- T-4.3 / T-4.6 incompatible demo: runs apicurio-registry:test with a schema that
         changes order_id from string to int64 (wire-type incompatible).
         This MUST fail with a clear compatibility rejection message.
         Demo: ./mvnw -pl order-contracts verify -Pincompatible-demo -Dapicurio.registry.url=http://localhost:8080
         (requires v1 or v2 already registered with BACKWARD rule) -->
    <profile>
      <id>incompatible-demo</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.apicurio</groupId>
            <artifactId>apicurio-registry-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>incompatible-compat-check</id>
                <phase>verify</phase>
                <goals><goal>register</goal></goals>
                <configuration>
                  <registryUrl>${apicurio.registry.url}</registryUrl>
                  <dryRun>true</dryRun>
                  <artifacts>
                    <artifact>
                      <groupId>events.orders</groupId>
                      <artifactId>OrderCreated</artifactId>
                      <file>${project.basedir}/src/test/resources/schemas/order-created-incompatible.proto</file>
                      <artifactType>PROTOBUF</artifactType>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
