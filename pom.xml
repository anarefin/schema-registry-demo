<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- T-0.1: multi-module parent -->
  <groupId>com.example</groupId>
  <artifactId>schema-registry-demo-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>schema-registry-demo-parent</name>
  <description>Apicurio + RabbitMQ schema-governed messaging POC (Maven, Java 25)</description>

  <modules>
    <module>schema-messaging-core</module>
    <module>event-contract-kit</module>
    <module>order-contracts</module>
    <module>customer-contracts</module>
    <module>producer-service</module>
    <module>consumer-service</module>
    <!-- Build-only: generates every contract's JSON Schema from its Java record (sole victools home). -->
    <module>schema-gen-tools</module>
  </modules>

  <!-- T-0.3: single source of versions. Module POMs inherit and never re-declare. -->
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <!-- Single source of truth for the Spring Boot BOM version; spring-boot-maven-plugin
         below shares this property and updates with it. -->
    <spring-boot.version>4.1.0</spring-boot.version>

    <!-- Pinned spec §3 versions -->
    <apicurio.version>3.2.0</apicurio.version>
    <!-- Default registry URL for the apicurio plugin (register / compat-check / incompatible-demo).
         Override on the CLI: -Dapicurio.registry.url=http://host:8080 -->
    <apicurio.registry.url>http://localhost:8080</apicurio.registry.url>
    <networknt-json-schema-validator.version>1.5.6</networknt-json-schema-validator.version>
    <testcontainers.version>1.20.4</testcontainers.version>

    <!-- Plugin versions -->
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-toolchains-plugin.version>3.2.0</maven-toolchains-plugin.version>
    <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
    <apicurio-registry-maven-plugin.version>3.2.0</apicurio-registry-maven-plugin.version>

    <!-- Code-first schema generation (schema-gen-tools) -->
    <victools.version>4.38.0</victools.version>
    <jakarta.validation-api.version>3.1.1</jakarta.validation-api.version>
    <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Boot 4.0 BOM -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${networknt-json-schema-validator.version}</version>
      </dependency>

      <!-- victools jsonschema-generator + modules (code-first, schema-gen-tools) -->
      <dependency>
        <groupId>com.github.victools</groupId>
        <artifactId>jsonschema-generator</artifactId>
        <version>${victools.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.victools</groupId>
        <artifactId>jsonschema-module-jackson</artifactId>
        <version>${victools.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.victools</groupId>
        <artifactId>jsonschema-module-jakarta-validation</artifactId>
        <version>${victools.version}</version>
      </dependency>
      <dependency>
        <groupId>jakarta.validation</groupId>
        <artifactId>jakarta.validation-api</artifactId>
        <version>${jakarta.validation-api.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- T-0.4: Java 25 toolchain + compiler -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-toolchains-plugin</artifactId>
          <version>${maven-toolchains-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>25</release>
          </configuration>
        </plugin>

        <!-- T-0.11: unit vs integration split -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <includes>
              <include>**/*Test.java</include>
            </includes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <includes>
              <include>**/*IT.java</include>
            </includes>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>

        <!-- Spring Boot BOM manages dependency versions only; the plugin version must be pinned
             here because we import the BOM rather than inherit spring-boot-starter-parent. -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>

        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
        </plugin>

        <!-- Schema governance (spec code-first D4). The plugin version + shared registryUrl live
             here once; each contract POM declares the plugin with only its per-artifact
             coordinates (the <artifacts> list). The compat-check / incompatible-demo profiles
             below reuse that same plugin declaration, so nothing is copy-pasted per domain. -->
        <plugin>
          <groupId>io.apicurio</groupId>
          <artifactId>apicurio-registry-maven-plugin</artifactId>
          <version>${apicurio-registry-maven-plugin.version}</version>
          <configuration>
            <registryUrl>${apicurio.registry.url}</registryUrl>
            <canonicalize>true</canonicalize>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- T-0.4: select the JDK 25 toolchain for every module -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-toolchains-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>toolchain</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <toolchains>
            <jdk>
              <version>25</version>
            </jdk>
          </toolchains>
        </configuration>
      </plugin>

      <!-- T-0.11: wire Failsafe (integration-test + verify) for all modules -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Schema-governance profiles (spec code-first D4). Defined once here and inherited by every
       contract module. Each profile only adds a dry-run `register` execution on the apicurio
       plugin; the artifact coordinates come from the contract POM:
         - compat-check     reuses the module's plugin-level <artifacts> (the generated schemas),
                            so the CI merge gate validates exactly what `register` would publish.
         - incompatible-demo overrides that list with the single incompatible test resource the
                            module names via the apicurio.incompatible.* properties.
       Both require a running registry; override its URL with -Dapicurio.registry.url=. -->
  <profiles>
    <!-- CI merge gate: dry-run register every generated schema; an incompatible change fails the
         goal and fails the merge. Requires a running registry:
         ./mvnw -pl order-contracts,customer-contracts verify -Pcompat-check -->
    <profile>
      <id>compat-check</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.apicurio</groupId>
            <artifactId>apicurio-registry-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>compat-gate</id>
                <phase>verify</phase>
                <goals><goal>register</goal></goals>
                <configuration>
                  <dryRun>true</dryRun>
                  <!-- <artifacts> inherited from the module's plugin-level <configuration>. -->
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Incompatible-change demo: dry-run register a schema that changes an existing property's
         type — incompatible under every level. MUST fail with a clear compatibility rejection
         (requires a prior registered version + FORWARD rule). The module supplies the one
         incompatible resource via apicurio.incompatible.{group,artifact,file}:
         ./mvnw -pl order-contracts verify -Pincompatible-demo -Dapicurio.registry.url=http://localhost:8080 -->
    <profile>
      <id>incompatible-demo</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.apicurio</groupId>
            <artifactId>apicurio-registry-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>incompatible-compat-check</id>
                <phase>verify</phase>
                <goals><goal>register</goal></goals>
                <configuration>
                  <dryRun>true</dryRun>
                  <!-- Replace (not append to) any inherited plugin-level <artifacts>. -->
                  <artifacts combine.self="override">
                    <artifact>
                      <groupId>${apicurio.incompatible.group}</groupId>
                      <artifactId>${apicurio.incompatible.artifact}</artifactId>
                      <file>${apicurio.incompatible.file}</file>
                      <artifactType>JSON</artifactType>
                      <!-- Force a new-version registration so the FORWARD rule actually adjudicates
                           the change. Without this the goal defaults to ifExists=FAIL and dies with
                           ArtifactAlreadyExistsException *before* the compatibility check runs,
                           masking the real (compatibility) rejection this demo is meant to show. -->
                      <ifExists>CREATE_VERSION</ifExists>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
