flowchart LR
    boot["Workflow 1: bootstrap<br/>(manual · once per env)<br/>POST rules via REST<br/>orders · customers · payments = FORWARD"]

    dev["Developer edits<br/>*-contracts<br/>(schema-first: edit schema)<br/>(code-first: edit record)"] --> pr["Open Pull Request"]
    pr --> drift{"Workflow 0: schema-drift-check<br/>on: pull_request (paths: payment-contracts)<br/>ubuntu-latest · NO registry<br/>mvnw process-classes + git diff --exit-code"}
    drift -->|"schema stale<br/>(record changed,<br/>schema not regenerated)"| blocked
    drift -->|"schema up-to-date"| cc
    pr --> cc{"Workflow 2: compat-check<br/>on: pull_request (paths: *-contracts)<br/>mvnw verify -Pcompat-check<br/>register -DdryRun (READ-ONLY)"}
    cc -->|INCOMPATIBLE| blocked["&#10060; PR blocked<br/>developer fixes"]
    blocked --> pr
    cc -->|compatible| merge["&#9989; merge to main"]
    merge --> reg["Workflow 3: register<br/>on: push main (paths: *-contracts)<br/>apicurio-registry:register<br/>FIND_OR_CREATE_VERSION (idempotent)"]
    reg --> live[("New version live<br/>in Apicurio")]

    boot -. "rules must exist first" .-> cc
    boot -. "rules enforced on write" .-> reg

    subgraph runner["self-hosted runner (apicurio-local) · JDK 25"]
        cc
        reg
        boot
    end
    runner -. "localhost:8080" .-> live
