graph TB
    subgraph dev["Build-time (Maven modules)"]
        core["schema-messaging-core<br/>(domain-agnostic library)"]
        oc["order-contracts<br/>OrderCreated · JSON Schema<br/>schema-first (schema → POJO)"]
        cc["customer-contracts<br/>CustomerRegistered · JSON Schema<br/>schema-first (schema → POJO)"]
        pc["payment-contracts<br/>PaymentProcessed · JSON Schema<br/>code-first (record → schema) · demo"]
        core -. "core must NOT depend<br/>on contracts (enforcer-banned)" .- oc
        core -. "core must NOT depend<br/>on contracts (enforcer-banned)" .- cc
    end

    subgraph run["Runtime services (Spring Boot 4 · Java 25)"]
        prod["producer-service :8081"]
        cons["consumer-service :8082"]
    end

    subgraph infra["Infrastructure (docker compose)"]
        reg["Apicurio Registry :8080<br/>+ UI :8888"]
        pg[("PostgreSQL<br/>registry storage")]
        rmq["RabbitMQ :5672<br/>mgmt :15672"]
    end

    prod -->|depends on| core
    cons -->|depends on| core
    prod --> oc & cc
    cons --> oc & cc

    reg --> pg
    pc -. "generated schema<br/>registered via CI" .-> reg
    prod -->|"resolve + validate schema"| reg
    cons -->|"resolve schema"| reg
    prod -->|"publish raw bytes<br/>+ X-Schema-* headers"| rmq
    rmq -->|"consume"| cons
