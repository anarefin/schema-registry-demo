<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>schema-registry-demo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- Domain-agnostic AMQP topology + event-contract runtime metadata kit (spec
       contract-owned-amqp-topology D1/D5; ADR-0006). Carries reusable retry-ladder +
       naming-convention logic, plus the TypeMapping/SchemaCoordinates/SchemaType data types
       shared between contracts modules and schema-messaging-core. Depended on by
       order-contracts, customer-contracts, and (since ADR-0006) schema-messaging-core. Stays a
       pure leaf module itself: no dependency on schema-messaging-core or either *-contracts
       module in either direction. -->
  <artifactId>event-contract-kit</artifactId>
  <packaging>jar</packaging>

  <dependencies>
    <dependency>
      <groupId>org.springframework.amqp</groupId>
      <artifactId>spring-rabbit</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Keep this module a pure leaf: no dependency on core or either contracts module (spec
           contract-owned-amqp-topology Principle 2). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-core-and-contracts-modules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.example:schema-messaging-core</exclude>
                    <exclude>com.example:order-contracts</exclude>
                    <exclude>com.example:customer-contracts</exclude>
                  </excludes>
                  <message>event-contract-kit must stay a pure leaf module (no dependency on core or any *-contracts module).</message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
