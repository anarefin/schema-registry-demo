<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>schema-registry-demo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- T-1.3: JSON Schema contracts jar. Carries PaymentProcessed schema generated from
       POJOs via victools jsonschema-generator + Jackson + Jakarta Validation modules. -->
  <artifactId>payment-contracts</artifactId>
  <packaging>jar</packaging>

  <properties>
    <!-- Override on CLI: ./mvnw -pl payment-contracts apicurio-registry:register -Dapicurio.registry.url=http://host:8080 -->
    <apicurio.registry.url>http://localhost:8080</apicurio.registry.url>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- victools jsonschema-generator: runtime dependency for POJO-to-schema generation -->
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-generator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-module-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-module-jakarta-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- T-3.4: generate payment-processed.schema.json from PaymentProcessedEvent record. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>generate-payment-schema</id>
            <phase>process-classes</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>com.example.contracts.payments.codefirst.SchemaGenerator</mainClass>
              <arguments>
                <argument>${project.basedir}/src/main/resources/schemas/payment-processed.schema.json</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- T-5.2 bootstrap: registers PaymentProcessed v1 (FIND_OR_CREATE_VERSION is idempotent).
           Run once after 'docker compose up', then attach the FORWARD rule:
             ./mvnw -pl payment-contracts apicurio-registry:register
             curl -s -X POST \
               "http://localhost:8080/apis/registry/v3/groups/events.payments/artifacts/PaymentProcessed/rules" \
               -H 'Content-Type: application/json' \
               -d '{"ruleType":"COMPATIBILITY","config":"FORWARD"}' -->
      <plugin>
        <groupId>io.apicurio</groupId>
        <artifactId>apicurio-registry-maven-plugin</artifactId>
        <version>${apicurio-registry-maven-plugin.version}</version>
        <configuration>
          <registryUrl>${apicurio.registry.url}</registryUrl>
          <artifacts>
            <artifact>
              <groupId>events.payments</groupId>
              <artifactId>PaymentProcessed</artifactId>
              <file>${project.basedir}/src/main/resources/schemas/payment-processed.schema.json</file>
              <artifactType>JSON</artifactType>
              <ifExists>FIND_OR_CREATE_VERSION</ifExists>
            </artifact>
          </artifacts>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- T-5.1 CI merge gate: dry-run register checks the generated schema is FORWARD-compatible
         with the version already in the registry. Requires a running registry.
         Run: ./mvnw -pl payment-contracts verify -Pcompat-check -Dapicurio.registry.url=http://localhost:8080 -->
    <profile>
      <id>compat-check</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.apicurio</groupId>
            <artifactId>apicurio-registry-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>compat-gate</id>
                <phase>verify</phase>
                <goals><goal>register</goal></goals>
                <configuration>
                  <registryUrl>${apicurio.registry.url}</registryUrl>
                  <dryRun>true</dryRun>
                  <artifacts>
                    <artifact>
                      <groupId>events.payments</groupId>
                      <artifactId>PaymentProcessed</artifactId>
                      <file>${project.basedir}/src/main/resources/schemas/payment-processed.schema.json</file>
                      <artifactType>JSON</artifactType>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
