<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>schema-registry-demo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- Build-only generator — the SOLE victools home (ADR-0003). Dependency-free with respect to
       every *-contracts module (compile AND test scope): each contracts module instead declares
       this jar as an exec-maven-plugin dependency and invokes SchemaGeneratorCli against its own
       @GenerateSchema-annotated classes (package scan of target/classes) at its own
       process-classes phase. NEVER on any service's runtime classpath. -->
  <artifactId>schema-gen-tools</artifactId>
  <packaging>jar</packaging>

  <dependencies>
    <!-- victools jsonschema-generator + modules (versions managed by the parent POM). -->
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-generator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-module-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-module-jakarta-validation</artifactId>
    </dependency>
    <!-- Required by JakartaValidationModule at generation time (annotation types on the
         generator classpath). Contracts supply the same API when invoking via exec-maven-plugin. -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- This module ships EventMappingProcessor via META-INF/services, so the processor is on
           its own test-compile classpath. Disable implicit annotation processing here so it never
           self-activates on the @EventMapping test fixtures (several are deliberately invalid); the
           processor is exercised explicitly by EventMappingProcessorTest's in-JVM compiler. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <proc>none</proc>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
