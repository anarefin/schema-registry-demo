<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>schema-registry-demo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- T-1.1/T-1.3: build-only generator — the SOLE victools home. Depends on both contract
       modules to read their annotated event records and regenerate each committed JSON Schema.
       NEVER on any service's runtime classpath (spec D1). -->
  <artifactId>schema-gen-tools</artifactId>
  <packaging>jar</packaging>

  <dependencies>
    <!-- Source of truth: the annotated event records live in these contract modules. -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>order-contracts</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>customer-contracts</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- victools jsonschema-generator + modules (versions managed by the parent POM). -->
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-generator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-module-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-module-jakarta-validation</artifactId>
    </dependency>

    <!-- T-1.4 SchemaDeterminismTest (Surefire): JUnit 5 + AssertJ. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- T-1.3: regenerate every schema in GeneratedSchemas.ALL from its record. No arguments
           => the CLI regenerates all six targets, writing into each owning contract module's
           src/main/resources/schemas/. Bound to process-classes (after the module's classes and
           the contract records on the classpath are compiled).
           Run standalone via: ./mvnw -pl schema-gen-tools process-classes -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-contract-schemas</id>
            <phase>process-classes</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>com.example.schemagen.SchemaGeneratorCli</mainClass>
              <!-- exec:java runs in-process with the reactor (root) working directory, so the
                   ../<contract-module>/... relative paths in GeneratedSchemas.ALL would escape the
                   repo. Pin them to this module's basedir so generation writes into the committed
                   locations regardless of where Maven was invoked from. -->
              <systemProperties>
                <systemProperty>
                  <key>schemagen.basedir</key>
                  <value>${project.basedir}</value>
                </systemProperty>
              </systemProperties>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
