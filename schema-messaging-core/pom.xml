<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>schema-registry-demo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- Domain-agnostic library jar. NO spring-boot-maven-plugin repackage. -->
  <artifactId>schema-messaging-core</artifactId>
  <packaging>jar</packaging>

  <dependencies>
    <!-- Spring AMQP: Message, MessageConverter, MessageProperties, RabbitTemplate -->
    <dependency>
      <groupId>org.springframework.amqp</groupId>
      <artifactId>spring-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.amqp</groupId>
      <artifactId>spring-rabbit</artifactId>
    </dependency>

    <!-- Spring Boot autoconfigure for @ConfigurationProperties + @AutoConfiguration -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <!-- networknt JSON Schema validator: JsonSchemaStrategy -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>

    <!-- Jackson: JSON serialization (version managed by Spring Boot BOM) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Jackson 2 JSR-310 datatype module: serializes java.time.Instant (event createdAt/
         registeredAt fields) as ISO-8601 strings. Spring Boot 4.0's jackson starter ships
         Jackson 3 (tools.jackson), so this Jackson 2 module is NOT otherwise on the classpath
         and findAndRegisterModules() would skip java.time support without it. -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <!-- Annotation processor for @ConfigurationProperties metadata -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- T-0.10: forbid any dependency on the *-contracts modules (core must stay domain-agnostic). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-contracts-modules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.example:order-contracts</exclude>
                    <exclude>com.example:customer-contracts</exclude>
                    <exclude>com.example:amqp-topology-kit</exclude>
                  </excludes>
                  <message>schema-messaging-core must not depend on any *-contracts module or amqp-topology-kit (it is domain-agnostic).</message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
